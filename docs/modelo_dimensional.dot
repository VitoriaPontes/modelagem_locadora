digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="1.0", fontname="Arial"];
  node [shape=plain, fontname="Arial"];
  edge [color="#6b7280", penwidth=1.2, arrowsize=0.7, fontname="Arial", fontsize=9];
  dim_cliente [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#1f2937"><FONT COLOR="white"><B>dim_cliente</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK skCliente</TD></TR><TR><TD ALIGN="LEFT">idClienteOrigem</TD></TR><TR><TD ALIGN="LEFT">nomeCliente</TD></TR><TR><TD ALIGN="LEFT">cidade / estado / pais</TD></TR></TABLE> >];
  dim_carro [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#1f2937"><FONT COLOR="white"><B>dim_carro</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK skCarro</TD></TR><TR><TD ALIGN="LEFT">idCarroOrigem</TD></TR><TR><TD ALIGN="LEFT">chassi / marca / modelo</TD></TR><TR><TD ALIGN="LEFT">ano</TD></TR></TABLE> >];
  dim_combustivel [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#1f2937"><FONT COLOR="white"><B>dim_combustivel</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK skCombustivel</TD></TR><TR><TD ALIGN="LEFT">idCombustivelOrigem</TD></TR><TR><TD ALIGN="LEFT">tipo</TD></TR></TABLE> >];
  dim_vendedor [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#1f2937"><FONT COLOR="white"><B>dim_vendedor</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK skVendedor</TD></TR><TR><TD ALIGN="LEFT">idVendedorOrigem</TD></TR><TR><TD ALIGN="LEFT">nome / sexo / estado</TD></TR></TABLE> >];
  dim_data [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#1f2937"><FONT COLOR="white"><B>dim_data</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK skData (YYYYMMDD)</TD></TR><TR><TD ALIGN="LEFT">data / ano / trimestre</TD></TR><TR><TD ALIGN="LEFT">mes / semana / dia</TD></TR><TR><TD ALIGN="LEFT">diaSemana / fimDeSemana</TD></TR></TABLE> >];
  fato_locacao [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#111827"><FONT COLOR="white"><B>fato_locacao</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK skLocacao</TD></TR><TR><TD ALIGN="LEFT">FK skCliente / skCarro</TD></TR><TR><TD ALIGN="LEFT">FK skCombustivel / skVendedor</TD></TR><TR><TD ALIGN="LEFT">FK skDataLocacao / skDataEntrega</TD></TR><TR><TD ALIGN="LEFT">kmCarro</TD></TR><TR><TD ALIGN="LEFT">qtdDiaria</TD></TR><TR><TD ALIGN="LEFT">vlrDiaria</TD></TR><TR><TD ALIGN="LEFT">valorTotal</TD></TR><TR><TD ALIGN="LEFT">diasCalendario</TD></TR></TABLE> >];
  dim_cliente -> fato_locacao [label="1 : N"];
  dim_carro -> fato_locacao [label="1 : N"];
  dim_combustivel -> fato_locacao [label="1 : N"];
  dim_vendedor -> fato_locacao [label="1 : N"];
  dim_data -> fato_locacao [label="1 : N", headlabel="locação / entrega"];
}
